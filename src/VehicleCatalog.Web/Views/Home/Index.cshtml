@model VehicleCatalog.Web.Models.VehicleSearchViewModel
@{
    ViewData["Title"] = "Vehicle Catalog";
}

<div class="hero-section">
    <h1 class="hero-title">
        <span class="gradient-text">Vehicle Catalog</span>
    </h1>
    <p class="hero-subtitle">Discover vehicle makes, types, and models from the NHTSA database</p>
</div>

<div class="search-container">
    <div class="search-card">
        <div class="card-header">
            <h2>Search Vehicles</h2>
            <p>Select a manufacturer and year to explore available vehicles</p>
        </div>

        <div class="search-form">
            <div class="form-group">
                <label for="makeSearch">
                    <i class="icon">🚗</i> Vehicle Make
                </label>
                <div class="searchable-select" id="makeSelectContainer">
                    <input type="text" 
                           id="makeSearch" 
                           class="form-control" 
                           placeholder="Type to search makes..." 
                           autocomplete="off" />
                    <input type="hidden" id="makeSelect" name="makeSelect" />
                    <div class="dropdown-list" id="makeDropdown">
                        @foreach (var make in Model.Makes)
                        {
                            <div class="dropdown-item" data-value="@make.MakeId" data-text="@make.MakeName">
                                @make.MakeName
                            </div>
                        }
                    </div>
                </div>
                <small class="form-hint">Start typing to filter makes (e.g., "Toyota", "Ford")</small>
            </div>

            <div class="form-group">
                <label for="yearInput">
                    <i class="icon">📅</i> Model Year
                </label>
                <input type="number" id="yearInput" class="form-control" 
                       placeholder="e.g., 2020" 
                       min="1900" 
                       max="@(DateTime.Now.Year + 2)" />
                <small class="form-hint">Enter a year between 1900 and @(DateTime.Now.Year + 2)</small>
            </div>

            <button id="searchBtn" class="btn-primary">
                <span class="btn-content">
                    <i class="icon">🔍</i>
                    <span>Search Vehicles</span>
                </span>
            </button>
        </div>
    </div>

    <div id="loadingIndicator" class="loading-indicator" style="display: none;">
        <div class="spinner"></div>
        <p>Loading vehicle data...</p>
    </div>

    <div id="resultsContainer" class="results-container" style="display: none;">
        <div id="vehicleTypesSection" class="results-section" style="display: none;">
            <h3 class="section-title">
                <span class="icon-badge">🏷️</span>
                Vehicle Types
            </h3>
            <div id="vehicleTypesList" class="cards-grid"></div>
        </div>

        <div id="vehicleModelsSection" class="results-section" style="display: none;">
            <h3 class="section-title">
                <span class="icon-badge">🚙</span>
                Available Models
            </h3>
            <div id="vehicleModelsList" class="cards-grid models-grid"></div>
        </div>
    </div>

    <div id="errorContainer" class="error-container" style="display: none;">
        <div class="error-card">
            <span class="error-icon">⚠️</span>
            <p id="errorMessage"></p>
        </div>
    </div>

    <div id="noResultsContainer" class="no-results" style="display: none;">
        <div class="no-results-card">
            <span class="no-results-icon">🔍</span>
            <h3>No Results Found</h3>
            <p>We couldn't find any vehicles matching your search criteria.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vehicle-search.js"></script>
}
